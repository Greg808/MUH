---

interface Props {
  class?: string;
  padded?: boolean;
}

const { class: className = "", padded = true } = Astro.props;
---

<div
  class:list={[
    "flex flex-col gap-0 rounded-lg border border-brand-line bg-brand-surface text-brand-text shadow-none",
    padded && "p-5 sm:p-6",
    className,
  ]}
>
  <slot />
</div>
