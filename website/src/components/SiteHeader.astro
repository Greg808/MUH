---
import NavigationItems from './NavigationItems.astro';
import ButtonLink from './ui/ButtonLink.astro';
const homePrefix = Astro.url.pathname === '/' ? '' : '/';
---
<header class="site-header">
  <div class="site-container header-inner">
    <a class="brand" href={`${homePrefix}#start`} aria-label="MUH – zur Startseite"><img src="/images/muh-logo.webp" alt="MUH Malerei & Handwerk – Wir kümmern uns darum" width="900" height="236" /></a>
    <nav class="desktop-nav" aria-label="Hauptnavigation"><NavigationItems name="desktop-audiences" /></nav>
    <ButtonLink href="#kontakt" class="header-cta">Projekt besprechen <span aria-hidden="true">↗</span></ButtonLink>
    <details class="mobile-menu">
      <summary>Menü <span aria-hidden="true">☰</span></summary>
      <nav aria-label="Mobile Navigation"><NavigationItems name="mobile-audiences" /><a href="#kontakt">Kontakt aufnehmen ↗</a></nav>
    </details>
  </div>
</header>
<script>
  const header = document.querySelector<HTMLElement>('.site-header');
  const closeMenus = () => header?.querySelectorAll<HTMLDetailsElement>('details[open]').forEach(menu => menu.open = false);
  header?.addEventListener('click', event => {
    if ((event.target as Element).closest('a')) closeMenus();
  });
  header?.addEventListener('keydown', event => {
    if (event.key !== 'Escape') return;
    const menu = (event.target as Element).closest<HTMLDetailsElement>('details[open]');
    if (menu) { menu.open = false; menu.querySelector<HTMLElement>(':scope > summary')?.focus(); }
  });
  document.addEventListener('click', event => {
    if (!header?.contains(event.target as Node)) closeMenus();
  });
</script>
