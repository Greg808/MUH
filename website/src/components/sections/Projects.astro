---
import ProjectComparison from './ProjectComparison.astro';
import SectionFrame from '../layout/SectionFrame.astro';
import { projects } from '@content/site';
---
<SectionFrame id="projekte" eyebrow="Einblicke in unsere Arbeit" title="Räume verändern. Möglichkeiten schaffen." text="Wohnung, Eingangsbereich oder Geschäftslokal: Entdecken Sie Aufnahmen aus unseren Projekten." tone="soft">
  <ProjectComparison />
  <div class="project-grid project-grid-secondary">{projects.map(item => <article class="project-card">
    <img src={`/images/${item.image}-800.webp`} srcset={`/images/${item.image}-480.webp 480w, /images/${item.image}-800.webp 800w`} sizes="auto, (min-width: 1264px) 580px, (min-width: 900px) calc((100vw - 64px - 40px) / 2), (min-width: 640px) calc((100vw - 2 * clamp(16px, 3vw, 32px) - 28px) / 2), (min-width: 360px) calc(100vw - 48px), calc(100vw - 32px)" alt={item.alt} width="800" height={item.image.startsWith('project-retail') ? 533 : 600} loading="lazy" decoding="async" />
    <div><p class="project-meta">{item.category}</p><h3>{item.title}</h3><p class="description">{item.text}</p><p class="sample-note"><span class="sample-tag">Beispielbeschreibung</span> Projektdetails werden ergänzt.</p></div>
  </article>)}</div>
</SectionFrame>
