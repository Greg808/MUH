---
import { navigation } from '@content/site';
const homePrefix = Astro.url.pathname === '/' ? '' : '/';
const hrefFor = (href: string) => href.startsWith('#') ? `${homePrefix}${href}` : href;
---
<footer class="site-footer">
  <div class="site-container">
    <div class="footer-inner"><strong>MUH · Malerei & Handwerk</strong><span>Wir kümmern uns darum.</span><a href="#start">Zurück nach oben ↑</a></div>
    <nav class="footer-nav" aria-label="Footernavigation">{navigation.map(item => item.links ? <div><strong>{item.label}</strong>{item.links.map(link => <a href={hrefFor(link.href)} aria-current={link.href === Astro.url.pathname ? 'page' : undefined}>{link.label}</a>)}</div> : <a href={hrefFor(item.href)}>{item.label}</a>)}</nav>
    <p class="footer-note">Präsentationsentwurf · Wien · Rechtliche Angaben folgen vor Veröffentlichung.</p>
  </div>
</footer>
